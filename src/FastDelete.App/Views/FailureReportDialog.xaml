<Window x:Class="FastDelete.App.Views.FailureReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Some files could not be deleted" Width="820" Height="480"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Try again" ToolTip="Try to delete the failed items once more"
                    Click="Retry_Click" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Copy list" ToolTip="Copy the list to the clipboard"
                    Click="Copy_Click" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Save as file…" Click="ExportCsv_Click" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Close" IsCancel="True" Click="Close_Click" Padding="14,6"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="Summary" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <DataGrid ItemsSource="{Binding Failures}" AutoGenerateColumns="False" IsReadOnly="True" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File or folder" Binding="{Binding Path}" Width="4*"/>
                <DataGridTextColumn Header="Problem" Binding="{Binding Message}" Width="2*"/>
                <DataGridTextColumn Header="Can retry" Binding="{Binding Retryable}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
