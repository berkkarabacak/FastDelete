<Window x:Class="FastDelete.App.Views.OutcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastDelete" Width="620" SizeToContent="Height"
        MaxHeight="640"
        FontFamily="Archivo, Segoe UI" FontSize="17"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Paper}"
        Foreground="{DynamicResource Brush.Foreground}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="8" Background="{DynamicResource Brush.Ink}"/>
        <Grid DockPanel.Dock="Bottom" Margin="32,28,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Grid.Column="0" Style="{StaticResource DialogInkButton}" Click="Primary_Click"/>
            <Button x:Name="CloseButton" Grid.Column="2" Content="Close" Style="{StaticResource DialogLineButton}"
                    IsCancel="True" Click="Close_Click"/>
        </Grid>
        <StackPanel Margin="32,32,32,0">
            <Border x:Name="CheckMark" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,18"
                    Background="{DynamicResource Brush.Ink}">
                <TextBlock Text="✓" Foreground="{DynamicResource Brush.Paper}" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="Headline" FontSize="32" FontWeight="ExtraBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Body" FontSize="19" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <ScrollViewer x:Name="ListHost" MaxHeight="220" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="NameList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="0,0,0,1" MinHeight="52" Padding="4,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="15" Margin="12,0,0,0"
                                               Foreground="{DynamicResource Brush.ForegroundDim}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="Note" FontSize="16" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.ForegroundDim}"/>
        </StackPanel>
    </DockPanel>
</Window>
