<Window x:Class="FastDelete.App.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Please confirm" SizeToContent="WidthAndHeight"
        FontSize="15"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <StackPanel Margin="24" Width="560">
        <TextBlock x:Name="Headline" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="PathIntro" Text="These are the ones you picked:" Margin="0,12,0,4" FontSize="14"/>
        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="PathList" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource Brush.Foreground}"/>
        </ScrollViewer>
        <TextBlock x:Name="Contents" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14"
                   Foreground="{DynamicResource Brush.ForegroundDim}" Text="Checking what's inside…"/>
        <TextBlock x:Name="Warning" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel — keep my files" IsCancel="True" Margin="0,0,10,0" Padding="14,8" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Click="Confirm_Click" Padding="18,8" FontWeight="SemiBold" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
