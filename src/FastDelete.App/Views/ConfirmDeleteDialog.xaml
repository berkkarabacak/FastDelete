<Window x:Class="FastDelete.App.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Please confirm" SizeToContent="WidthAndHeight"
        MaxWidth="640" MaxHeight="720"
        FontSize="15"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <DockPanel Width="520" Margin="24">
        <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" MinHeight="48" IsCancel="True" Click="Cancel_Click">
                <TextBlock Text="Cancel — keep my files" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
            <Button x:Name="ConfirmButton" Grid.Column="2" MinHeight="48" Click="Confirm_Click" IsEnabled="False">
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
            </Button>
        </Grid>
        <StackPanel>
            <TextBlock x:Name="Headline" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PathIntro" Text="You picked:" Margin="0,12,0,4" FontSize="14"/>
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="PathList" TextWrapping="Wrap" FontSize="15"
                           Foreground="{DynamicResource Brush.Foreground}"/>
            </ScrollViewer>
            <TextBlock x:Name="Contents" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14"
                       Foreground="{DynamicResource Brush.ForegroundDim}" Text="Checking what's inside…"/>
            <TextBlock x:Name="Warning" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="14"/>
        </StackPanel>
    </DockPanel>
</Window>
